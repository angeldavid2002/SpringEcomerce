# Copy this file to .env and adjust the values. .env is local and ignored by Git.
# The database must exist before starting the application: ecomerce
DB_URL=jdbc:postgresql://localhost:5432/ecomerce
DB_USER=user
DB_PASS=password

# Demo users created on startup (local only). Set SEED_ENABLED=false elsewhere.
# The four values below are required when SEED_ENABLED=true.
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin1234!
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=Customer1234!

# JWT. Use a random secret, never the placeholder.
# Minimum length depends on JWT_ALGORITHM: HS256=32 bytes, HS384=48, HS512=64.
JWT_SECRET=change-me-with-at-least-32-bytes-long!!
JWT_ISSUER=ecomerce
JWT_EXPIRATION=PT1H
JWT_ALGORITHM=HS256

# BCrypt cost (rounds = 2^value). Valid range: 4 to 31.
BCRYPT_STRENGTH=10

# Image storage: Backblaze B2 (S3-compatible API).
# B2_ENABLED=false keeps the app running without a bucket: image uploads answer
# 503 and the rest of the API works normally.
# Create an application key in the B2 console (Buckets -> App Keys) and copy the
# bucket endpoint from the bucket details page.
B2_ENABLED=false
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=your-bucket-name
B2_ACCESS_KEY=keyID-from-b2
B2_SECRET_KEY=applicationKey-from-b2
# Lifetime of the signed URL returned to the frontend (ISO-8601 duration).
B2_PRESIGN_EXPIRATION=PT30M
# Max size in bytes and allowed content types (images only).
B2_MAX_FILE_SIZE=5242880
B2_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif
# Prefix of the stored object keys: products/<productId>/<uuid>.<ext>
B2_PREFIX=products
